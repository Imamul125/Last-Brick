
default_platform(:ios)

platform :ios do
  desc "Upload to TestFlight after Unity Cloud Build generates the IPA"
  lane :upload_to_testflight do
    puts "--- Starting Fastlane TestFlight Upload ---"
    
    # Unity Cloud Build passes the IPA path in an environment variable, 
    # or it is automatically picked up by pilot if it`s in the standard output path.
    # UCB stores the ipa path in UCB_BUILD_ARTIFACT_PATH or similar, 
    # but we can also just find it.
    ipa_path = ENV["UCB_IPA_PATH"] || Dir["../*.ipa", "../../*.ipa", "*.ipa"].first
    
    if ipa_path.nil? || !File.exist?(ipa_path)
      puts "ERROR: Could not find IPA file!"
      # Let us not fail the build if upload fails, just log it.
      next
    end
    
    puts "Found IPA at: #{ipa_path}"
    
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      in_house: false
    )
    
    pilot(
      ipa: ipa_path,
      skip_submission: true,
      skip_waiting_for_build_processing: true
    )
    
    puts "--- TestFlight Upload Complete ---"
  end
end

